# Platform-wide data root (all persistent data lives here, in tsfm-arena/ and cache/).
TRADEQ_DATA_DIR=/absolute/path/to/Tradeq/data
# Hugging Face cache under the data root; the Makefile and CLI derive it from settings.
HF_HOME=/absolute/path/to/Tradeq/data/cache/huggingface
# Allow model adapters to download weights (Chronos, Kronos). Tests never download.
TSFM_ALLOW_DOWNLOADS=false
# Optional: alternative settings file.
# TSFM_SETTINGS_FILE=/absolute/path/to/settings.yaml
# Any setting can be overridden, e.g.:
# TSFM_EVALUATION__LONG_SHORT__COST_BPS=5
# TSFM_LEDGER__BASE_URL=http://127.0.0.1:8601
# TSFM_DATA__PIT__BASE_URL=http://127.0.0.1:8603
# TSFM_KRONOS__REPO_PATH=/absolute/path/to/Kronos
